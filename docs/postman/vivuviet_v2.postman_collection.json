        {
          "name": "getNotFound",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", function () {\r\n  pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"Content-Type is application/problem+json\", function () {\r\n  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");\r\n});\r\n\r\npm.test(\"Body in Problem Details (RFC 9457)\", function () {\r\n  const body = pm.response.json();\r\n  pm.expect(body.type).to.eql(\"about:blank\");\r\n  pm.expect(body.title).to.eql(\"Not Found\");\r\n  pm.expect(body.status).to.eql(404);\r\n  pm.expect(body).to.have.property(\"detail\");\r\n  pm.expect(body.instance).to.include(\"/destinations/not-found\");\r\n});"
                ]
              }
            }
          ],
