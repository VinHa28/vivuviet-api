      "item": [
        {
          "name": "getAllDestinations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function (){\r\n    pm.response.to.have.status(200);\r\n})\r\n\r\npm.test(\"Return array or 34 province/city\", function () {\r\n    const body = pm.response.json();\r\n\r\n    pm.expect(body).to.be.an(\"array\");\r\n    pm.expect(body).to.have.lengthOf(34);\r\n})\r\n\r\npm.test(\"Each element contains the fields specified in the DTO\", function () {\r\n  const first = pm.response.json()[0];\r\n  pm.expect(first).to.have.all.keys(\"code\", \"name\", \"shortDescription\", \"bannerUrl\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/destinations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "destinations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "getDestinationBySlug",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Đảo ngọc với bãi biển trong xanh, rừng nguyên sinh và hải sản tươi ngon.\", function () {\r\n  const body = pm.response.json();\r\n  pm.expect(body.slug).to.eql(\"phu-quoc\");\r\n  pm.expect(body.name).to.eql(\"Phú Quốc\");\r\n});"
                ]
              }
            }
          ],
